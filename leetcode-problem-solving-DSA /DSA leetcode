
#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {2, 3, 2, 5, 6};
  
    int n = 5;

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i] == arr[j])
            {
                cout<<"duplicat remove";
                 n=n-1;
                return 0;
            }
        }
       
    }
	
    for(int i=0;i<n;i++)
    {
    	cout<<arr[i]<<"  ";
    }
    
    
}
